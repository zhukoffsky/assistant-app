<?xml version="1.0" encoding="utf-8"?>
<!--
  Только для debug-сборки: зонд распознавания на устройстве, см. SpeechProbeReceiver.
  Защищён разрешением DUMP — оно есть у adb shell и нет у обычных приложений.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.SpeechProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.zhukoffsky.magpie.debug.SPEECH_PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
