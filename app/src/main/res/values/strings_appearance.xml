    <string name="appearance_theme_light">Light</string>
    <string name="appearance_theme_dark">Dark</string>

    <string name="appearance_language">Language</string>
    <string name="appearance_language_system">System</string>
    <string name="appearance_language_ru">Русский</string>
    <string name="appearance_language_en">English</string>

    
    <string name="appearance_language_note">Applies to app screens and notifications. The label under the icon follows the system language — change it in Android settings, App language.</string>
</resources>
