<?xml version="1.0" encoding="utf-8"?>
<!--
  Внешний вид вынесен в отдельный файл, а не дописан в strings.xml: так проще
  править тему и язык, не задевая строки остальных разделов. Android сливает
  все файлы в values/ в один набор ресурсов.
-->
