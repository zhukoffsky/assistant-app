<?xml version="1.0" encoding="utf-8"?>
<!--
  Передний слой адаптивной иконки: сорока с поднятым хвостом.

  До этого здесь лежал микрофон из стандартного набора Material — те же два
  контура, что в `ic_mic`. Он не был ни своим, ни объясняющим название.

  Силуэт читается дважды: как сидящая птица и как галочка — короткое плечо
  влево-вверх это голова с клювом, вершина внизу тело, длинное плечо
  вправо-вверх хвост. Для приложения, которое живёт словами «куплено» и
  «готово», второе чтение не случайность, а смысл.

  Порядок фигур важен: хвост уходит за тело, крыло ложится поверх и
  перекрывает основание хвоста — так же, как на исходном рисунке.

  Вся фигура лежит внутри окружности радиусом 33 от центра холста. Это
  безопасная зона адаптивной иконки: за её пределами лаунчер вправе срезать
  что угодно своей маской, а при параллаксе ещё и сдвинуть.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Хвост: прямой клинок под 45° с косым срезом на конце -->
    <path
        android:fillColor="#FF6B35"
        android:pathData="M57.5,63.5L71.5,39.5L77.5,32.5L78.5,43L64,65Z" />

    <!-- Клюв -->
    <path
        android:fillColor="#FF6B35"
        android:pathData="M30.5,43.5L22.5,47.5L30.5,50Z" />

    <!-- Тело: голова слита с корпусом, без перехвата на шее -->
    <path
        android:fillColor="#FCF5F0"
        android:pathData="M30,45C31,41.5 34.5,39.5 38,39.5C43.5,39.5 48.5,42.5 52,47C55.5,51.5 57,57.5 56.5,63.5C56,69.5 52,74 47,75.2C41.5,76.4 35.5,74.8 32,70.8C29,67 28,61 28.5,55C28.8,50.5 29.2,47 30,45Z" />

    <!-- Крыло: капля с остриём наружу, за пределы корпуса -->
    <path
        android:fillColor="#B5A79C"
        android:pathData="M41,53C48,51 55,54 62,62C66,67 69.5,72 70,74C70.2,74.8 69.5,75.2 68.5,74.8C62,72 52,69.5 46,67C41,64.5 39,58 41,53Z" />

    <!-- Глаз. Пропадает на мелких размерах — так и задумано -->
    <path
        android:fillColor="#3A3330"
        android:pathData="M37.5,46.4a1.9,1.9 0 1,0 -3.8,0a1.9,1.9 0 1,0 3.8,0Z" />
</vector>
